+
+#ifdef DEBUG_VGT
+#define DPRINTF(fmt, ...) \
+    do { fprintf(stderr, "vgt: " fmt, ## __VA_ARGS__); } while (0)
+#else
+#define DPRINTF(fmt, ...) \
