+#endif
+
+    assert(dev->devfn == 0x00);
+
+//  fprintf("vGT Config Write: addr=%x len=%x val=%x\n", addr, len, val);
+
+    switch (address) {
+#if 0
+        case 0x58:        // PAVPC Offset
+            xen_host_pci_set_block(o->host_dev, addr, val, len);
