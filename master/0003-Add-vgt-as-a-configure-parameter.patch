diff --git a/vl.c b/vl.c
index 951145c..a104f9a 100644
--- a/vl.c
+++ b/vl.c
@@ -4054,6 +4054,7 @@ int main(int argc, char **argv, char **envp)
                     exit(1);
                 }
                 break;
+#ifdef CONFIG_VGT
             case QEMU_OPTION_vgt_low_gm_sz:
                 {
                     char *ptr;
@@ -4072,6 +4073,7 @@ int main(int argc, char **argv, char **envp)
                     vgt_fence_sz = strtol(optarg, &ptr, 10);
                 }
                 break;
+#endif
             default:
                 os_parse_cmd_args(popt->index, optarg);
             }
