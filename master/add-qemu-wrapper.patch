diff --git a/mk/qemu-wrapper b/mk/qemu-wrapper
new file mode 100755
index 0000000..037a689
--- /dev/null
+++ b/mk/qemu-wrapper
@@ -0,0 +1,192 @@
+#! /usr/bin/python
+#
+# Copyright (C) 2016 Citrix Systems R&D Ltd.
+#
