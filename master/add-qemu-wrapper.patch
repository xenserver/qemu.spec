        $RPM_BUILD_ROOT/usr/share/locale
+install mk/qemu-wrapper $RPM_BUILD_ROOT%{_libdir}/xen/bin/qemu-wrapper
 
 %clean
 rm -rf $RPM_BUILD_ROOT
